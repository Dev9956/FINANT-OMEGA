# FININT OMEGA — Environment Configuration
# Copy to .env and fill in values. Never commit .env.

# Application
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=change-me-in-production

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=finintel_omega
POSTGRES_USER=finintel
POSTGRES_PASSWORD=change-me

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=finintel_omega
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Rust Engine (future)
# FININTEL_ENGINE_PATH=./rust/finintel-engine
